int sumXor(int n) {
    if (n == 0) return 1;
    int cnt0 = 0;
    while (n > 0) {
        if ((n & 1) == 0) cnt0++;
        n >>= 1;
    }
    return 1LL << cnt0;
}
void solve() {
    int n; cin >> n;
    cout << sumXor(n);
